# Pork Segmentation Supervisor - Configuration Example
# Copy this file to .env and fill in your values

# Application
APP_NAME="Pork Segmentation Supervisor"
APP_VERSION="1.0.0-MVP"
ENVIRONMENT="development"

# Database
DATABASE_URL="sqlite:///./data/supervisor.db"

# Model Configuration
MODEL_PATH="./data/models/unet_int8.tflite"
MODEL_VERSION="v1.0"
MODEL_INPUT_SIZE=512
MODEL_CONFIDENCE_THRESHOLD=0.75

# Active Learning
RETRAINING_THRESHOLD=50
UNCERTAINTY_METHOD="entropy"
HIGH_UNCERTAINTY_THRESHOLD=0.3

# Directories
UPLOAD_DIR="./data/uploads"
ANNOTATIONS_DIR="./data/annotations"
MODELS_DIR="./data/models"

# Logging
LOG_LEVEL="DEBUG"
LOG_FILE="./logs/supervisor.log"
LOG_ROTATION="10 MB"
LOG_RETENTION="30 days"

# Streamlit Server
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS="localhost"
STREAMLIT_THEME_PRIMARY_COLOR="#FF4B4B"
STREAMLIT_THEME_BACKGROUND_COLOR="#FFFFFF"

# File Upload
MAX_UPLOAD_SIZE_MB=10
SUPPORTED_FORMATS="jpg,jpeg,png,bmp"
IMAGE_PREPROCESSING_RESIZE=True

# Metrics Thresholds
DICE_THRESHOLD=0.85
IOU_THRESHOLD=0.80
TRACK_METRICS=True
